<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- Translations arrive incrementally from Translatewiki.net; don't fail the build while they lag. -->
    <issue id="MissingTranslation" severity="warning" />
    <!-- values-qq holds Translatewiki.net's message documentation, not a translation; its prose
         would otherwise trip every translation check (argument counts, typography, plurals). -->
    <issue id="all">
        <ignore path="src/main/res/values-qq/strings.xml" />
    </issue>
    <!-- Every user-facing string must go through strings.xml to be translatable. -->
    <issue id="HardcodedText" severity="error" />
    <!-- Compose is RTL-aware by default, but keep the check on for any future View-based code. -->
    <issue id="RtlHardcoded" severity="error" />
    <issue id="RtlCompat" severity="error" />
</lint>
